# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase)
# Use DATABASE_URL or individual DB_* variables below
DATABASE_URL=postgresql://user:password@host:5432/ecomm_db

# Alternative individual DB settings (used if DATABASE_URL is not set)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=ecomm_db
# DB_USER=postgres
# DB_PASSWORD=your_db_password

# Authentication & JWT
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRES_IN=1d
COOKIE_NAME=token

# CORS / Frontend Origin
CLIENT_ORIGIN=http://localhost:5173
